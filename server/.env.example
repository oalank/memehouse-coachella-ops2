# Database connection. Required for POST/PATCH/DELETE and real data.
# Must be a full Postgres URL with a real host (not a placeholder like "base" — that causes getaddrinfo ENOTFOUND base).
# Local Postgres:
#   DATABASE_URL=postgresql://user:password@localhost:5432/memehouse_ops
# Railway Postgres (from Railway Dashboard → your DB → Connect → Postgres URL):
#   DATABASE_URL=postgresql://postgres:xxx@containers-us-west-xxx.railway.app:5432/railway
#
# Auth (required in production). Use a long random string for SESSION_SECRET.
#   SESSION_SECRET=your-long-random-secret-here
# Optional: override seeded admin (created on first run if no users exist).
#   SEED_ADMIN_EMAIL=admin@yourcompany.com
#   SEED_ADMIN_PASSWORD=your-secure-password
#
# Demo-only (dev): skip login for local demo. Remove or false for real auth.
#   DEMO_BYPASS_AUTH=true
#
# Copy to .env and fill in your values:
#   cp .env.example .env

DATABASE_URL=
SESSION_SECRET=
