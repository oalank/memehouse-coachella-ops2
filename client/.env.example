# For production (Railway): set to your backend root so API requests hit the backend, not the frontend.
# Either name works. Get URL from Railway Dashboard → backend service → Settings → Networking
# VITE_API_URL=https://your-backend.railway.app
# VITE_API_BASE_URL=https://your-backend.railway.app

# Demo-only (dev): bypass login and open dashboard directly. Remove or leave unset for real auth.
# VITE_DEMO_BYPASS_AUTH=true
